# Normalize text files to LF in the repository and working tree
* text=auto eol=lf

# Binary assets
*.ico   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.pdf   binary

# Collapse lockfile diffs in pull requests
package-lock.json linguist-generated=true
